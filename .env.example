# --- Required ---
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/medilife?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string

# --- Optional ---
PORT=5001
NODE_ENV=development
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
MONGO_MAX_RETRIES=5
MONGO_RETRY_BASE_MS=2000

# Google Identity Services
# Create an OAuth web client in Google Cloud and add your origin (e.g. http://localhost:5001) as authorized.
GOOGLE_CLIENT_ID=

# SMTP email confirmations (leave blank to log emails to console instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=MEDILIFE
