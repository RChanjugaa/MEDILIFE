PORT=5001
MONGO_URI=mongodb://localhost:27017/medilife
JWT_SECRET=change_this_secret
NODE_ENV=development

# Google Identity Services
# Create an OAuth web client in Google Cloud and add http://localhost:5001 as an authorized origin.
GOOGLE_CLIENT_ID=

# SMTP email confirmations
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=MEDILIFE
